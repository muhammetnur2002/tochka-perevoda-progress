# =============================================================================
# Переменные окружения «Точка Перевода Прогресс».
# Скопируйте в .env.local (разработка) или задайте в окружении контейнера (прод).
# Обязательны только переменные Supabase. Всё остальное без ключей работает
# в mock-режиме: оплата имитируется, SMS/email/Telegram пишутся в лог.
# =============================================================================

# --- Сайт ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# info | warn | error | debug
LOG_LEVEL=info

# --- Supabase (ОБЯЗАТЕЛЬНО) — Project Settings → API ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Только сервер! Обходит RLS — никогда не передавайте в браузер.
SUPABASE_SERVICE_ROLE_KEY=
# Прямое подключение к Postgres (для pnpm db:push и бэкапов):
# Project Settings → Database → Connection string → URI (Session pooler, порт 5432)
# Локальный Supabase CLI: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=

# --- Секреты приложения ---
# Подпись токенов гостевого доступа к заказу и SMS-кодов (≥ 32 случайных символа).
# Если пусто — используется SUPABASE_SERVICE_ROLE_KEY. Сгенерировать: openssl rand -hex 32
ORDER_ACCESS_SECRET=
# Заголовок Authorization: Bearer <CRON_SECRET> для /api/cron/* и /api/notifications
CRON_SECRET=change-me

# --- Telegram (@BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Произвольная строка; передаётся Telegram в X-Telegram-Bot-Api-Secret-Token (обязательна в проде)
TELEGRAM_WEBHOOK_SECRET=
# Chat ID менеджеров через запятую (дополнительно к менеджерам с привязанным Telegram)
TELEGRAM_MANAGER_CHAT_IDS=

# --- ЮKassa (карта / СБП / QR). Без ключей — mock-провайдер ---
PAYMENT_PROVIDER=mock
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Чек 54-ФЗ через ЮKassa (нужна настроенная онлайн-касса); код НДС: 1 — без НДС
YOOKASSA_SEND_RECEIPT=false
YOOKASSA_VAT_CODE=1
# Свой список IP вебхука (по умолчанию — официальные диапазоны ЮKassa)
YOOKASSA_WEBHOOK_IPS=
# true — отключить проверку IP (только если прокси не передаёт X-Forwarded-For)
YOOKASSA_SKIP_IP_CHECK=false
# true — разрешить кнопку «Я оплатил(а)» mock-провайдера на демо-стенде в production
ALLOW_MOCK_PAYMENTS=false

# --- SMS.ru. Без ключа — SMS пишутся в лог ---
SMSRU_API_ID=
SMSRU_SENDER_NAME=
# Секрет в URL callback'а статусов: https://<сайт>/api/webhooks/sms?secret=<значение>
SMSRU_CALLBACK_SECRET=

# --- SMTP (email). Без хоста — письма пишутся в лог ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Точка Перевода <noreply@example.ru>"

# --- Файлы: supabase (по умолчанию) | yandex (Yandex Object Storage, S3) ---
STORAGE_DRIVER=supabase
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- ИИ (этап 2): off | yandexgpt | gigachat ---
AI_PROVIDER=off
YANDEXGPT_API_KEY=
YANDEXGPT_FOLDER_ID=
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=

# --- Демо без Supabase: каталог из src/lib/seed (заказы не работают) ---
NEXT_PUBLIC_DEMO_MODE=false
