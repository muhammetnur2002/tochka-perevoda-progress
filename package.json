{
  "name": "tochka-perevoda-progress",
  "version": "1.0.0",
  "private": true,
  "description": "Платформа бюро переводов «Точка Перевода Прогресс» — сайт, Telegram Mini App, CRM-админка",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:push": "tsx scripts/db-push.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:types": "tsx scripts/db-types.ts",
    "tg:set-webhook": "tsx scripts/telegram-set-webhook.ts",
    "brand:assets": "python scripts/make-brand-assets.py",
    "format": "prettier --write \"src/**/*.{ts,tsx,md}\" \"scripts/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "db:reset-check": "tsx scripts/db-push.ts --force",
    "test:sql": "node scripts/test-sql.mjs",
    "tg:poll": "tsx --conditions=react-server scripts/telegram-bot.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
